class Solution {
public:
    bool isGood(vector<int>& nums) {
        
        sort(nums.begin(), nums.end());

        int n = nums.size() - 1;

        // Last two elements should be n
        if(nums[n] != n || nums[n-1] != n)
            return false;

        // Check 1 to n-1 appear exactly once
        for(int i = 0; i < n-1; i++) {
            if(nums[i] != i + 1)
                return false;
        }

        return true;
    }
};
