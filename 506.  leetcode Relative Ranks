class Solution {
public:
    vector<string> findRelativeRanks(vector<int>& score) {
        int n = score.size();

        vector<pair<int,int>> arr;

        for (int i = 0; i < n; i++) {
            arr.push_back({score[i], i});
        }

        sort(arr.begin(), arr.end(), greater<pair<int,int>>());

        vector<string> ans(n);

        for (int i = 0; i < n; i++) {
            int idx = arr[i].second;

            ans[idx] = (i == 0) ? "Gold Medal" :
                       (i == 1) ? "Silver Medal" :
                       (i == 2) ? "Bronze Medal" :
                                  to_string(i + 1);
        }

        return ans;
    }
};
